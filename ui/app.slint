import { Theme, Card, Button, Field, Toggle, Slider, Segmented, Avatar } from "theme.slint";
export { Theme }
import { ScrollView, ListView } from "std-widgets.slint";

export struct NewsItem {
    title: string,
    date: string,
    summary: string,
    url: string,
    cover: image,
    has-cover: bool,
}

export struct ChangeItem {
    version: string,
    date: string,
    notes: string,
    current: bool,
}

export struct AccountItem {
    id: string,
    name: string,
    initial: string,
    licensed: bool,
    face: image,
    has-face: bool,
    selected: bool,
}

export struct FileItem {
    name: string,
    dir: string,
    size: string,
}

// Кнопка бічного меню з іконкою.
component NavButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> active;
    callback clicked;
    width: 80px;
    height: 60px;
    border-radius: 0px;
    background: root.active ? Theme.line : (ta.has-hover ? #ffffff08 : transparent);
    animate background { duration: 120ms; }
    Rectangle {
        x: 0;
        y: 16px;
        width: 3px;
        height: parent.height - 32px;
        border-radius: 0px;
        background: Theme.cyan;
        visible: root.active;
    }
    VerticalLayout {
        alignment: center;
        spacing: 4px;
        HorizontalLayout {
            alignment: center;
            Image {
                source: root.icon;
                width: 20px;
                height: 20px;
                colorize: root.active ? Theme.cyan : (ta.has-hover ? Theme.text : Theme.muted);
            }
        }
        Text {
            text: root.label;
            font-size: 10px;
            font-weight: 700;
            horizontal-alignment: center;
            color: root.active ? Theme.text : Theme.muted;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component SectionTitle inherits Text {
    font-family: Theme.display;
    font-weight: 800;
    font-size: 20px;
    color: Theme.text;
}

component NewsCard inherits Rectangle {
    in property <NewsItem> item;
    callback open(string);
    border-radius: 0px;
    background: ta.has-hover ? Theme.surface-solid.with-alpha(0.5) : Theme.surface;
    border-width: 2px;
    border-color: ta.has-hover ? Theme.line-strong : Theme.line;
    clip: true;
    animate background, border-color { duration: 150ms; }
    VerticalLayout {
        Rectangle {
            height: root.width * 0.45;
            background: Theme.line;
            if root.item.has-cover: Image {
                width: parent.width;
                height: parent.height;
                source: root.item.cover;
                image-fit: cover;
            }
            if !root.item.has-cover: Image {
                source: Theme.offline ? @image-url("../assets/logo-offline.svg") : @image-url("../assets/logo.svg");
                width: 44px;
                height: 44px;
                opacity: 0.6;
            }
        }
        VerticalLayout {
            padding: 14px;
            spacing: 6px;
            Text {
                text: root.item.date;
                font-family: Theme.mono;
                font-size: 11px;
                color: Theme.violet;
            }
            Text {
                text: root.item.title;
                font-weight: 700;
                font-size: 15px;
                color: Theme.text;
                wrap: word-wrap;
                overflow: elide;
                max-height: 44px;
            }
            Text {
                text: root.item.summary;
                font-size: 12px;
                color: Theme.muted;
                wrap: word-wrap;
                overflow: elide;
                max-height: 34px;
            }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.open(root.item.url); }
    }
}

component SettingRow inherits Rectangle {
    in property <string> title;
    in property <string> hint;
    min-height: 64px;
    HorizontalLayout {
        spacing: 24px;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 3px;
            Text {
                text: root.title;
                font-weight: 700;
                font-size: 14px;
                color: Theme.text;
            }
            Text {
                text: root.hint;
                font-size: 12px;
                color: Theme.muted;
                wrap: word-wrap;
                visible: root.hint != "";
            }
        }
        @children
    }
}

export component AppWindow inherits Window {
    in property <bool> edition-official: true;
    in property <bool> offline-allowed: true;
    title: root.edition-official ? "Altherra" : "Altherra Offline";
    icon: Theme.offline ? @image-url("../assets/icon-offline.png") : @image-url("../assets/icon.png");
    preferred-width: 1120px;
    preferred-height: 700px;
    min-width: 900px;
    min-height: 600px;
    background: Theme.bg;
    default-font-family: Theme.body;
    default-font-size: 14px;

    // Сторінка: 0 головна, 1 збірка, 2 налаштування, 3 журнал
    in-out property <int> page: 0;

    // Сервер і збірка
    in property <string> server-name: "Altherra";
    in property <string> tagline: "Адміністрація створює світ. Гравці створюють усе інше.";
    in property <int> server-state: 0; // 0 перевіряємо, 1 онлайн, 2 вимкнений
    in property <string> server-status: "перевіряємо сервер…";
    in property <bool> stats-visible: false;
    in property <string> stats-spark: "";
    in property <string> stats-peak: "—";
    in property <string> stats-unique: "—";
    in property <string> stats-tps: "—";
    in property <string> stats-uptime: "—";
    in property <string> mc-version: "";
    in property <string> loader-text: "";
    in property <string> build-info: "";
    in property <int> mods-count: 0;
    in property <bool> manifest-offline: false;
    in property <string> manifest-error: "";
    in property <[NewsItem]> news: [];
    in property <[ChangeItem]> changes: [];
    in property <bool> changes-loading: true;
    in property <[FileItem]> files: [];

    // Акаунти
    in property <[AccountItem]> accounts: [];
    in property <bool> has-account: false;
    in property <AccountItem> account;
    in-out property <bool> accounts-open: false;
    in property <bool> ms-available: false;
    in property <string> ms-code: "";
    in property <string> ms-url: "";
    in property <bool> ms-waiting: false;
    in property <string> acc-error: "";
    in-out property <string> offline-nick: "";

    // Запуск
    in property <bool> busy: false;
    in property <float> progress: 0;
    in property <string> status-text: "";
    in property <bool> game-running: false;
    in property <string> toast: "";
    in property <string> update-version: "";
    in property <bool> update-busy: false;

    // Налаштування
    in-out property <float> ram-gb: 4;
    in property <float> ram-max: 16;
    in property <float> ram-recommended: 4;
    in-out property <string> java-path: "";
    in-out property <string> jvm-args: "";
    in-out property <int> after-launch: 1;
    in-out property <bool> auto-connect: true;
    in property <string> game-dir: "";
    in property <string> version: "";

    // Журнал
    in property <[string]> log-lines: [];

    callback play();
    callback open-url(string);
    callback select-account(string);
    callback remove-account(string);
    callback add-offline(string);
    callback ms-login();
    callback ms-cancel();
    callback save-settings();
    callback open-game-dir();
    callback open-logs-dir();
    callback verify-files();
    callback refresh();
    callback kill-game();
    callback do-update();

    Image {
        width: parent.width;
        height: parent.height;
        source: Theme.offline ? @image-url("../assets/bg-offline.svg") : @image-url("../assets/bg.svg");
        image-fit: cover;
    }

    HorizontalLayout {
        // ---------- Бічне меню ----------
        Rectangle {
            width: 96px;
            background: Theme.bg.with-alpha(0.8);
            border-width: 0;
            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                background: Theme.line;
            }
            VerticalLayout {
                padding-top: 20px;
                padding-bottom: 16px;
                alignment: start;
                spacing: 6px;
                HorizontalLayout {
                    alignment: center;
                    padding-bottom: 22px;
                    Image {
                        source: Theme.offline ? @image-url("../assets/logo-offline.svg") : @image-url("../assets/logo.svg");
                        width: 38px;
                        height: 38px;
                    }
                }
                HorizontalLayout {
                    alignment: center;
                    NavButton { icon: @image-url("../assets/icon-home.svg"); label: "Головна"; active: root.page == 0; clicked => { root.page = 0; } }
                }
                HorizontalLayout {
                    alignment: center;
                    NavButton { icon: @image-url("../assets/icon-box.svg"); label: "Збірка"; active: root.page == 1; clicked => { root.page = 1; } }
                }
                HorizontalLayout {
                    alignment: center;
                    NavButton { icon: @image-url("../assets/icon-gear.svg"); label: "Налаштування"; active: root.page == 2; clicked => { root.page = 2; } }
                }
                HorizontalLayout {
                    alignment: center;
                    NavButton { icon: @image-url("../assets/icon-term.svg"); label: "Журнал"; active: root.page == 3; clicked => { root.page = 3; } }
                }
                HorizontalLayout {
                    alignment: center;
                    NavButton { icon: @image-url("../assets/icon-news.svg"); label: "Що нового"; active: root.page == 4; clicked => { root.page = 4; } }
                }
            }
        }

        // ---------- Вміст ----------
        VerticalLayout {
            horizontal-stretch: 1;

            Rectangle {
                vertical-stretch: 1;

                // Головна
                if root.page == 0: VerticalLayout {
                    padding: 40px;
                    padding-bottom: 16px;
                    spacing: 0;

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            y: (parent.height - 8px) / 2;
                            border-radius: 0px;
                            background: root.server-state == 1 ? Theme.green : (root.server-state == 2 ? Theme.red : Theme.muted);
                        }
                        st := Text {
                            text: root.server-status
                                + (root.mc-version != "" ? "   ·   Minecraft " + root.mc-version : "")
                                + (root.loader-text != "" ? "   ·   " + root.loader-text : "")
                                + (root.mods-count > 0 ? "   ·   модів: " + root.mods-count : "");
                            color: Theme.muted;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        if root.update-version != "": Rectangle {
                            height: 30px;
                            width: up-t.preferred-width + 24px;
                            border-radius: 0px;
                            background: up-ta.has-hover && !root.update-busy ? Theme.line-strong : Theme.line;
                            up-t := Text {
                                text: root.update-busy ? "Оновлюємо…" : "Вийшла версія " + root.update-version + " — оновити";
                                color: Theme.text;
                                font-weight: 700;
                                font-size: 12px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            up-ta := TouchArea {
                                enabled: !root.update-busy && !root.busy && !root.game-running;
                                mouse-cursor: self.enabled ? pointer : default;
                                clicked => { root.do-update(); }
                            }
                        }
                    }

                    Rectangle { height: 26px; }
                    Text {
                        text: root.edition-official ? "Altherra" : "Altherra Offline";
                        font-family: Theme.display;
                        font-weight: 800;
                        font-size: 54px;
                        color: Theme.text;
                    }
                    Text {
                        text: root.tagline;
                        font-size: 17px;
                        color: Theme.muted;
                        wrap: word-wrap;
                    }

                    if root.stats-visible: Rectangle { height: 22px; }
                    if root.stats-visible: Card {
                        height: 112px;
                        max-width: 640px;
                        HorizontalLayout {
                            padding: 18px;
                            spacing: 22px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 6px;
                                Text { text: "Гравці за добу"; font-size: 12px; color: Theme.muted; }
                                Rectangle {
                                    vertical-stretch: 1;
                                    Path {
                                        width: parent.width;
                                        height: parent.height;
                                        viewbox-width: 100;
                                        viewbox-height: 30;
                                        commands: root.stats-spark;
                                        stroke: Theme.cyan;
                                        stroke-width: 2px;
                                        fill: transparent;
                                    }
                                }
                            }
                            for kpi in [
                                { label: "пік сьогодні", value: root.stats-peak },
                                { label: "гравців за день", value: root.stats-unique },
                                { label: "TPS", value: root.stats-tps },
                                { label: "працює", value: root.stats-uptime },
                            ]: VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                Text { text: kpi.value; font-family: Theme.display; font-weight: 800; font-size: 18px; color: Theme.text; horizontal-alignment: center; }
                                Text { text: kpi.label; font-size: 11px; color: Theme.muted; horizontal-alignment: center; }
                            }
                        }
                    }

                    if root.manifest-offline || root.manifest-error != "": Rectangle {
                        height: 44px;
                        border-radius: 0px;
                        background: #ffc24d12;
                        border-width: 2px;
                        border-color: #ffc24d59;
                        Text {
                            x: 16px;
                            width: parent.width - 32px;
                            height: parent.height;
                            vertical-alignment: center;
                            text: root.manifest-error != "" ? root.manifest-error : "Немає звʼязку із сервером лаунчера — граємо з останньою збіркою.";
                            color: Theme.amber;
                            font-size: 13px;
                            overflow: elide;
                        }
                    }

                    Rectangle { vertical-stretch: 1; min-height: 20px; }

                    if root.news.length > 0: VerticalLayout {
                        spacing: 14px;
                        HorizontalLayout {
                            SectionTitle { text: "Новини"; }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        HorizontalLayout {
                            spacing: 14px;
                            for n in root.news: NewsCard {
                                item: n;
                                horizontal-stretch: 1;
                                max-width: 320px;
                                open(u) => { root.open-url(u); }
                            }
                            if root.news.length < 3: Rectangle { horizontal-stretch: 3 - root.news.length; }
                        }
                    }
                }

                // Збірка
                if root.page == 1: VerticalLayout {
                    padding: 40px;
                    spacing: 18px;
                    HorizontalLayout {
                        VerticalLayout {
                            spacing: 4px;
                            SectionTitle { text: "Збірка"; font-size: 26px; }
                            Text { text: root.build-info; color: Theme.muted; font-family: Theme.mono; font-size: 12px; }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Button { text: "Оновити"; width: 120px; clicked => { root.refresh(); } }
                    }
                    Card {
                        vertical-stretch: 1;
                        if root.files.length == 0: Text {
                            text: "У збірці немає модів — гра запуститься як є.";
                            color: Theme.muted;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        ListView {
                            x: 8px;
                            y: 8px;
                            width: parent.width - 16px;
                            height: parent.height - 16px;
                            for f in root.files: Rectangle {
                                height: 52px;
                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    spacing: 12px;
                                    Rectangle {
                                        width: 34px;
                                        height: 34px;
                                        y: 9px;
                                        border-radius: 0px;
                                        background: Theme.cyan.with-alpha(0.08);
                                        Text {
                                            text: f.dir == "mods" ? "M" : f.dir == "resourcepacks" ? "R" : f.dir == "shaderpacks" ? "S" : "C";
                                            color: Theme.cyan;
                                            font-family: Theme.display;
                                            font-weight: 800;
                                        }
                                    }
                                    Text {
                                        text: f.name;
                                        color: Theme.text;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }
                                    Text { text: f.dir; color: Theme.muted; font-family: Theme.mono; font-size: 11px; vertical-alignment: center; }
                                    Text { text: f.size; color: Theme.muted; font-family: Theme.mono; font-size: 11px; vertical-alignment: center; width: 70px; horizontal-alignment: right; }
                                }
                                Rectangle {
                                    y: parent.height - 1px;
                                    height: 1px;
                                    background: Theme.line;
                                }
                            }
                        }
                    }
                }

                // Налаштування
                if root.page == 2: ScrollView {
                    VerticalLayout {
                        padding: 40px;
                        spacing: 18px;
                        alignment: start;
                        SectionTitle { text: "Налаштування"; font-size: 26px; }
                        Card {
                            VerticalLayout {
                                padding: 24px;
                                padding-top: 12px;
                                padding-bottom: 12px;
                                SettingRow {
                                    title: "Памʼять для гри";
                                    hint: "Сервер радить " + round(root.ram-recommended) + " ГБ. Більше половини памʼяті компʼютера ставити не варто.";
                                    HorizontalLayout {
                                        width: 300px;
                                        spacing: 14px;
                                        alignment: end;
                                        Slider {
                                            y: 18px;
                                            width: 200px;
                                            minimum: 1;
                                            maximum: root.ram-max;
                                            step: 1;
                                            value <=> root.ram-gb;
                                            changed => { root.save-settings(); }
                                        }
                                        Rectangle {
                                            y: 16px;
                                            width: 70px;
                                            height: 32px;
                                            border-radius: 0px;
                                            background: Theme.cyan.with-alpha(0.1);
                                            Text { text: round(root.ram-gb) + " ГБ"; color: Theme.cyan; font-family: Theme.mono; font-size: 13px; }
                                        }
                                    }
                                }
                                Rectangle { height: 1px; background: Theme.line; }
                                SettingRow {
                                    title: "Одразу заходити на сервер";
                                    hint: "Гра після запуску сама підключиться до Altherra.";
                                    Toggle { y: 20px; checked <=> root.auto-connect; toggled => { root.save-settings(); } }
                                }
                                Rectangle { height: 1px; background: Theme.line; }
                                SettingRow {
                                    title: "Після запуску гри";
                                    hint: "";
                                    Segmented {
                                        y: 12px;
                                        width: 330px;
                                        options: ["Лишити", "Згорнути", "Закрити"];
                                        current <=> root.after-launch;
                                        changed => { root.save-settings(); }
                                    }
                                }
                                Rectangle { height: 1px; background: Theme.line; }
                                SettingRow {
                                    title: "Java";
                                    hint: "Порожньо — лаунчер сам поставить потрібну Java від Mojang.";
                                    Field {
                                        y: 11px;
                                        width: 330px;
                                        mono: true;
                                        placeholder: "Авто";
                                        text <=> root.java-path;
                                        edited => { root.save-settings(); }
                                    }
                                }
                                Rectangle { height: 1px; background: Theme.line; }
                                SettingRow {
                                    title: "Аргументи JVM";
                                    hint: "Для тих, хто знає, навіщо це.";
                                    Field {
                                        y: 11px;
                                        width: 330px;
                                        mono: true;
                                        placeholder: "-XX:+UseZGC";
                                        text <=> root.jvm-args;
                                        edited => { root.save-settings(); }
                                    }
                                }
                            }
                        }
                        Card {
                            VerticalLayout {
                                padding: 24px;
                                spacing: 14px;
                                Text { text: "Файли гри"; font-weight: 700; color: Theme.text; }
                                Text { text: root.game-dir; font-family: Theme.mono; font-size: 12px; color: Theme.muted; overflow: elide; }
                                HorizontalLayout {
                                    spacing: 10px;
                                    alignment: start;
                                    Button { text: "Відкрити теку гри"; clicked => { root.open-game-dir(); } }
                                    Button { text: "Перевірити файли"; enabled: !root.busy && !root.game-running; clicked => { root.verify-files(); } }
                                }
                            }
                        }
                        Text { text: (root.edition-official ? "Altherra Launcher " : "Altherra Offline ") + root.version + " · Made with Slint"; font-family: Theme.mono; font-size: 11px; color: #8a97ad88; }
                    }
                }

                // Журнал
                if root.page == 3: VerticalLayout {
                    padding: 40px;
                    spacing: 18px;
                    HorizontalLayout {
                        SectionTitle { text: "Журнал гри"; font-size: 26px; }
                        Rectangle { horizontal-stretch: 1; }
                        Button { text: "Теку журналів"; clicked => { root.open-logs-dir(); } }
                    }
                    Card {
                        vertical-stretch: 1;
                        background: Theme.bg.with-alpha(0.9);
                        if root.log-lines.length == 0: Text {
                            text: "Тут зʼявиться вивід гри після запуску.";
                            color: Theme.muted;
                        }
                        log := ListView {
                            x: 10px;
                            y: 10px;
                            width: parent.width - 20px;
                            height: parent.height - 20px;
                            for line in root.log-lines: Text {
                                text: line;
                                font-family: Theme.mono;
                                font-size: 11px;
                                color: Theme.muted;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                // Що нового
                if root.page == 4: VerticalLayout {
                    padding: 40px;
                    spacing: 18px;
                    HorizontalLayout {
                        SectionTitle { text: "Що нового"; font-size: 26px; }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: "версія " + root.version;
                            font-family: Theme.mono;
                            font-size: 12px;
                            color: Theme.muted;
                            vertical-alignment: center;
                        }
                    }
                    if root.changes.length == 0: Text {
                        text: root.changes-loading ? "Завантажуємо історію версій…" : "Не вдалося отримати історію версій з GitHub.";
                        color: Theme.muted;
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 12px;
                            for c in root.changes: Card {
                                border-color: c.current ? Theme.cyan : Theme.line;
                                VerticalLayout {
                                    padding: 18px;
                                    spacing: 8px;
                                    HorizontalLayout {
                                        spacing: 10px;
                                        Text {
                                            text: c.version;
                                            font-family: Theme.display;
                                            font-weight: 800;
                                            font-size: 16px;
                                            color: Theme.text;
                                        }
                                        if c.current: Rectangle {
                                            width: cur-label.preferred-width + 14px;
                                            height: 20px;
                                            background: Theme.cyan;
                                            cur-label := Text {
                                                text: "у тебе";
                                                font-size: 11px;
                                                font-weight: 700;
                                                color: Theme.on-accent;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                        Text {
                                            text: c.date;
                                            font-family: Theme.mono;
                                            font-size: 11px;
                                            color: Theme.violet;
                                            vertical-alignment: center;
                                        }
                                    }
                                    Text {
                                        text: c.notes == "" ? "Опису змін немає." : c.notes;
                                        font-size: 13px;
                                        color: c.notes == "" ? Theme.muted : Theme.text;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ---------- Нижня панель ----------
            Rectangle {
                height: 96px;
                background: Theme.bg.with-alpha(0.9);
                Rectangle {
                    height: 1px;
                    y: 0;
                    background: Theme.line;
                }
                HorizontalLayout {
                    padding-left: 28px;
                    padding-right: 28px;
                    spacing: 20px;

                    // Акаунт
                    acc := Rectangle {
                        y: 18px;
                        height: 60px;
                        width: 250px;
                        border-radius: 0px;
                        background: acc-ta.has-hover ? #ffffff0d : Theme.surface;
                        border-width: 2px;
                        border-color: acc-ta.has-hover ? Theme.line-strong : Theme.line;
                        HorizontalLayout {
                            padding: 10px;
                            spacing: 12px;
                            Avatar {
                                size: 40px;
                                face: root.account.face;
                                has-face: root.has-account && root.account.has-face;
                                initial: root.has-account ? root.account.initial : "+";
                            }
                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                horizontal-stretch: 1;
                                Text {
                                    text: root.has-account ? root.account.name : "Додай акаунт";
                                    font-weight: 700;
                                    font-size: 15px;
                                    color: Theme.text;
                                    overflow: elide;
                                }
                                Text {
                                    text: !root.edition-official ? (root.has-account ? "гравець" : "натисни, щоб додати нік")
                                        : !root.has-account ? "ліцензія або нік" : root.account.licensed ? "ліцензія" : "без ліцензії";
                                    font-family: Theme.mono;
                                    font-size: 11px;
                                    color: root.has-account && root.account.licensed ? Theme.green : Theme.muted;
                                }
                            }
                            Text { text: "⌃"; color: Theme.muted; vertical-alignment: center; font-size: 16px; }
                        }
                        acc-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.accounts-open = true; }
                        }
                    }

                    // Прогрес
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 8px;
                        Text {
                            text: root.status-text;
                            color: Theme.muted;
                            font-size: 13px;
                            overflow: elide;
                        }
                        if root.busy: Rectangle {
                            height: 6px;
                            border-radius: 0px;
                            background: #ffffff14;
                            Rectangle {
                                x: 0;
                                width: parent.width * clamp(root.progress, 0, 1);
                                height: parent.height;
                                border-radius: 0px;
                                background: Theme.accent;
                                animate width { duration: 200ms; }
                            }
                        }
                    }

                    // Грати
                    Rectangle {
                        y: 16px;
                        width: 230px;
                        height: 64px;
                        border-radius: 0px;
                        clip: true;
                        property <bool> can-play: !root.busy && !root.game-running && root.has-account;
                        background: self.can-play ? (play-ta.pressed ? Theme.violet : (play-ta.has-hover ? Theme.pink.mix(Theme.cyan, 0.25) : Theme.cyan)) : (root.game-running ? Theme.green.with-alpha(0.12) : Theme.line);
                        animate background { duration: 90ms; }
                        // Темніша смуга знизу — як у кнопок самої гри.
                        Rectangle {
                            y: parent.height - 5px;
                            height: 5px;
                            background: parent.can-play && !play-ta.pressed ? Theme.violet : transparent;
                        }
                        Text {
                            y: play-ta.pressed ? 2px : 0px;
                            height: parent.height - 4px;
                            text: root.game-running ? "Гра запущена" : (root.busy ? round(root.progress * 100) + "%" : "Грати");
                            font-family: Theme.display;
                            font-weight: 800;
                            font-size: root.game-running ? 16px : 22px;
                            color: parent.can-play ? Theme.on-accent : (root.game-running ? Theme.green : Theme.muted);
                            vertical-alignment: center;
                        }
                        play-ta := TouchArea {
                            enabled: parent.can-play;
                            mouse-cursor: parent.can-play ? pointer : default;
                            clicked => { root.play(); }
                        }
                    }
                }
            }
        }
    }

    // ---------- Акаунти ----------
    if root.accounts-open: Rectangle {
        background: Theme.bg.with-alpha(0.82);
        TouchArea {
            clicked => {
                if (!root.ms-waiting) { root.accounts-open = false; }
            }
        }
        Rectangle {
            width: 460px;
            height: box.preferred-height;
            border-radius: 0px;
            background: Theme.bg2;
            border-width: 2px;
            border-color: Theme.line-strong;
            TouchArea { }
            box := VerticalLayout {
                padding: 26px;
                spacing: 14px;
                HorizontalLayout {
                    SectionTitle { text: "Акаунти"; }
                    Rectangle { horizontal-stretch: 1; }
                    Rectangle {
                        width: 34px;
                        height: 34px;
                        border-radius: 0px;
                        border-width: 2px;
                        border-color: Theme.line-strong;
                        Text { text: "×"; font-size: 20px; color: Theme.text; }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.ms-cancel();
                                root.accounts-open = false;
                            }
                        }
                    }
                }

                for a in root.accounts: Rectangle {
                    height: 58px;
                    border-radius: 0px;
                    background: a.selected ? Theme.cyan.with-alpha(0.08) : (row-ta.has-hover ? #ffffff0a : transparent);
                    border-width: 2px;
                    border-color: a.selected ? Theme.cyan.with-alpha(0.35) : Theme.line;
                    row-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.select-account(a.id); }
                    }
                    HorizontalLayout {
                        padding: 9px;
                        padding-right: 6px;
                        spacing: 12px;
                        Avatar { size: 40px; face: a.face; has-face: a.has-face; initial: a.initial; }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text { text: a.name; font-weight: 700; color: Theme.text; overflow: elide; }
                            if root.edition-official: Text { text: a.licensed ? "ліцензія" : "без ліцензії"; font-family: Theme.mono; font-size: 11px; color: a.licensed ? Theme.green : Theme.muted; }
                        }
                        Rectangle {
                            width: 34px;
                            border-radius: 0px;
                            background: del-ta.has-hover ? #ff5c7a1f : transparent;
                            Text { text: "✕"; color: del-ta.has-hover ? Theme.red : Theme.muted; }
                            del-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.remove-account(a.id); }
                            }
                        }
                    }
                }

                if root.accounts.length > 0: Rectangle { height: 1px; background: Theme.line; }

                // Вхід через Microsoft
                if root.edition-official && !root.ms-waiting: Button {
                    text: root.ms-available ? "Увійти з ліцензією Microsoft" : "Ліцензія поки недоступна";
                    primary: root.ms-available;
                    enabled: root.ms-available;
                    clicked => { root.ms-login(); }
                }
                if root.edition-official && root.ms-waiting: Rectangle {
                    border-radius: 0px;
                    background: Theme.cyan.with-alpha(0.05);
                    border-width: 2px;
                    border-color: Theme.cyan.with-alpha(0.25);
                    height: ms-box.preferred-height;
                    ms-box := VerticalLayout {
                        padding: 18px;
                        spacing: 10px;
                        Text {
                            text: root.ms-code == "" ? "Підключаємося до Microsoft…" : "Відкрий сторінку входу й введи код:";
                            color: Theme.muted;
                            horizontal-alignment: center;
                        }
                        if root.ms-code != "": TextInput {
                            text: root.ms-code;
                            read-only: true;
                            font-family: Theme.mono;
                            font-size: 30px;
                            letter-spacing: 4px;
                            color: Theme.cyan;
                            horizontal-alignment: center;
                            selection-background-color: Theme.cyan.with-alpha(0.33);
                        }
                        HorizontalLayout {
                            alignment: center;
                            spacing: 10px;
                            if root.ms-code != "": Button { text: "Відкрити сторінку входу"; primary: true; clicked => { root.open-url(root.ms-url); } }
                            Button { text: "Скасувати"; clicked => { root.ms-cancel(); } }
                        }
                    }
                }

                // Без ліцензії
                Text { text: root.edition-official ? "Без ліцензії" : "Твій нік"; font-weight: 700; color: Theme.text; }
                HorizontalLayout {
                    spacing: 10px;
                    nick := Field {
                        horizontal-stretch: 1;
                        enabled: root.offline-allowed;
                        placeholder: root.offline-allowed ? "Нік, напр. Steve_UA" : "Спершу увійди з ліцензією";
                        text <=> root.offline-nick;
                        accepted(t) => { root.add-offline(t); }
                    }
                    Button { text: "Додати"; width: 100px; enabled: root.offline-allowed; clicked => { root.add-offline(root.offline-nick); } }
                }
                Text {
                    text: root.offline-allowed
                        ? "Нік — 3–16 символів: латиниця, цифри й _. На сервері вхід захищає пароль /login."
                        : "У цій версії гра за ніком відкривається після входу з ліцензією. Немає ліцензії — завантаж Altherra Offline із сайту.";
                    font-size: 12px;
                    color: Theme.muted;
                    wrap: word-wrap;
                }
                if root.acc-error != "": Text {
                    text: root.acc-error;
                    color: Theme.red;
                    font-size: 13px;
                    wrap: word-wrap;
                }
            }
        }
    }

    // ---------- Сповіщення ----------
    if root.toast != "": Rectangle {
        y: parent.height - 150px;
        x: (parent.width - self.width) / 2;
        width: min(toast-t.preferred-width + 40px, parent.width - 80px);
        height: toast-t.preferred-height + 24px;
        border-radius: 0px;
        background: Theme.surface-solid.with-alpha(0.95);
        border-width: 2px;
        border-color: Theme.red;
        toast-t := Text {
            width: parent.width - 40px;
            text: root.toast;
            color: Theme.text;
            font-weight: 700;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
    }
}
