// Кольори, шрифти й базові елементи в стилі сайту Altherra.
import "fonts/Unbounded-ExtraBold.ttf";
import "fonts/Unbounded-SemiBold.ttf";
import "fonts/Manrope-Medium.ttf";
import "fonts/Manrope-Bold.ttf";
import "fonts/JetBrainsMono-Medium.ttf";

export global Theme {
    out property <color> bg: #05070d;
    out property <color> bg2: #0a0f1c;
    out property <color> surface: #10182aa0;
    out property <color> surface-solid: #0c1322;
    out property <color> line: #78beff24;
    out property <color> line-strong: #78dcff59;
    out property <color> text: #e6edf7;
    out property <color> muted: #8a97ad;
    out property <color> cyan: #3cf2ff;
    out property <color> violet: #9b6bff;
    out property <color> pink: #ff4fd8;
    out property <color> green: #4dffa6;
    out property <color> amber: #ffc24d;
    out property <color> red: #ff5c7a;
    out property <brush> accent: @linear-gradient(100deg, #3cf2ff 0%, #9b6bff 100%);
    out property <string> display: "Unbounded";
    out property <string> body: "Manrope";
    out property <string> mono: "JetBrains Mono";
}

export component Card inherits Rectangle {
    background: Theme.surface;
    border-color: Theme.line;
    border-width: 1px;
    border-radius: 18px;
}

export component Button inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    in property <bool> danger: false;
    in property <length> font-size: 14px;
    callback clicked;
    height: 42px;
    min-width: label.preferred-width + 36px;
    border-radius: 12px;
    background: !root.primary ? (ta.has-hover && root.enabled ? #ffffff10 : Theme.surface) : Theme.accent;
    border-width: root.primary ? 0 : 1px;
    border-color: root.danger && ta.has-hover ? Theme.red : (ta.has-hover && root.enabled ? Theme.violet : Theme.line-strong);
    opacity: root.enabled ? 1 : 0.45;
    drop-shadow-blur: root.primary && root.enabled ? (ta.has-hover ? 30px : 20px) : 0;
    drop-shadow-color: root.primary && root.enabled ? #3cf2ff55 : transparent;
    drop-shadow-offset-y: root.primary && root.enabled ? 6px : 0;
    animate drop-shadow-blur, background { duration: 150ms; }
    label := Text {
        text: root.text;
        color: root.primary ? #04060b : (root.danger && ta.has-hover ? Theme.red : Theme.text);
        font-family: Theme.body;
        font-weight: 700;
        font-size: root.font-size;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// Поле вводу з рамкою, підсвіткою фокуса й підказкою.
export component Field inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> mono: false;
    in property <bool> enabled: true;
    callback accepted(string);
    callback edited(string);
    height: 42px;
    border-radius: 11px;
    background: #03050abf;
    border-width: 1px;
    border-color: input.has-focus ? Theme.cyan : Theme.line-strong;
    opacity: root.enabled ? 1 : 0.5;
    forward-focus: input;
    Text {
        x: 13px;
        text: root.placeholder;
        visible: input.text == "";
        color: #8a97ad99;
        font-family: root.mono ? Theme.mono : Theme.body;
        font-size: 14px;
        vertical-alignment: center;
        height: parent.height;
    }
    input := TextInput {
        x: 13px;
        width: parent.width - 26px;
        height: parent.height;
        text <=> root.text;
        enabled: root.enabled;
        color: Theme.text;
        font-family: root.mono ? Theme.mono : Theme.body;
        font-size: 14px;
        vertical-alignment: center;
        single-line: true;
        selection-background-color: #3cf2ff55;
        accepted => { root.accepted(self.text); }
        edited => { root.edited(self.text); }
    }
}

export component Toggle inherits Rectangle {
    in-out property <bool> checked;
    callback toggled(bool);
    width: 42px;
    height: 24px;
    border-radius: 12px;
    background: root.checked ? Theme.accent : #ffffff1f;
    knob := Rectangle {
        y: 3px;
        x: root.checked ? 21px : 3px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: white;
        animate x { duration: 150ms; easing: ease-out; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

// Повзунок без зайвого: доріжка з градієнтом і кругла ручка.
export component Slider inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> step: 1;
    in-out property <float> value;
    callback changed(float);
    height: 28px;
    property <float> frac: (root.value - root.minimum) / max(0.0001, root.maximum - root.minimum);
    Rectangle {
        y: (parent.height - 6px) / 2;
        height: 6px;
        border-radius: 3px;
        background: #ffffff1a;
    }
    Rectangle {
        x: 0;
        y: (parent.height - 6px) / 2;
        width: (root.width - 20px) * root.frac + 10px;
        height: 6px;
        border-radius: 3px;
        background: Theme.accent;
    }
    Rectangle {
        x: (root.width - 20px) * root.frac;
        y: (parent.height - 20px) / 2;
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: white;
        drop-shadow-blur: 12px;
        drop-shadow-color: #3cf2ff88;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        function set(px: length) {
            let f = clamp((px - 10px) / (root.width - 20px), 0, 1);
            let raw = root.minimum + f * (root.maximum - root.minimum);
            root.value = clamp(round(raw / root.step) * root.step, root.minimum, root.maximum);
            root.changed(root.value);
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { self.set(self.mouse-x); }
        }
        moved => { if (self.pressed) { self.set(self.mouse-x); } }
    }
}

// Сегментований перемикач на кілька варіантів.
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in-out property <int> current;
    callback changed(int);
    height: 40px;
    border-radius: 12px;
    background: #03050abf;
    border-width: 1px;
    border-color: Theme.line-strong;
    HorizontalLayout {
        padding: 4px;
        spacing: 4px;
        for opt[i] in root.options: Rectangle {
            border-radius: 9px;
            background: i == root.current ? @linear-gradient(100deg, #3cf2ff33 0%, #9b6bff40 100%) : (sta.has-hover ? #ffffff0d : transparent);
            Text {
                text: opt;
                color: i == root.current ? Theme.text : Theme.muted;
                font-family: Theme.body;
                font-weight: 700;
                font-size: 13px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            sta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.current = i;
                    root.changed(i);
                }
            }
        }
    }
}

// Квадратна аватарка: обличчя скіна або перша літера ніка.
export component Avatar inherits Rectangle {
    in property <image> face;
    in property <bool> has-face;
    in property <string> initial;
    in property <length> size: 40px;
    width: root.size;
    height: root.size;
    border-radius: root.size * 0.24;
    clip: true;
    background: @linear-gradient(140deg, #3cf2ff40 0%, #9b6bff55 100%);
    if root.has-face: Image {
        width: parent.width;
        height: parent.height;
        source: root.face;
        image-rendering: pixelated;
    }
    if !root.has-face: Text {
        text: root.initial == "" ? "?" : root.initial;
        font-family: Theme.display;
        font-weight: 800;
        font-size: root.size * 0.42;
        color: Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
        overflow: clip;
    }
}
