// Кольори, шрифти й базові елементи в стилі сайту Altherra.
import "fonts/Unbounded-ExtraBold.ttf";
import "fonts/Unbounded-SemiBold.ttf";
import "fonts/Manrope-Medium.ttf";
import "fonts/Manrope-Bold.ttf";
import "fonts/JetBrainsMono-Medium.ttf";

export global Theme {
    // Altherra Offline — червона, як її логотип.
    in property <bool> offline: false;
    // Щільні, теплі темні тони замість неону; акцент — кольори з логотипа.
    out property <color> bg: offline ? #110d0d : #0d0f11;
    out property <color> bg2: offline ? #191313 : #14171a;
    out property <color> surface: offline ? #1b1515 : #16191c;
    out property <color> surface-solid: offline ? #1b1515 : #16191c;
    out property <color> line: offline ? #2c2323 : #23272c;
    out property <color> line-strong: offline ? #3e3131 : #353b42;
    out property <color> text: offline ? #ede5e3 : #e6e4df;
    out property <color> muted: offline ? #9c8f8d : #8a8f96;
    // «cyan» — основний акцент, «violet» — другий колір логотипа.
    out property <color> cyan: offline ? #e5484d : #4fc4b4;
    out property <color> violet: offline ? #c2373c : #3a9fc0;
    out property <color> pink: offline ? #ffb0a3 : #a8eee2;
    out property <color> green: #5bd18a;
    out property <color> amber: #e8b04a;
    out property <color> red: #e5484d;
    out property <brush> accent: offline ? #e5484d : #4fc4b4;
    // Текст на акцентній кнопці.
    out property <color> on-accent: offline ? #ffffff : #08201c;
    out property <string> display: "Unbounded";
    out property <string> body: "Manrope";
    out property <string> mono: "JetBrains Mono";
}

export component Card inherits Rectangle {
    background: Theme.surface;
    border-color: Theme.line;
    border-width: 2px;
    border-radius: 0px;
}

export component Button inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    in property <bool> danger: false;
    in property <length> font-size: 14px;
    callback clicked;
    height: 40px;
    min-width: label.preferred-width + 32px;
    border-radius: 0px;
    background: root.primary ? (ta.pressed ? Theme.violet : Theme.accent) : (ta.has-hover && root.enabled ? Theme.line-strong : Theme.line);
    border-width: 2px;
    border-color: #00000088;
    opacity: root.enabled ? 1 : 0.45;
    // Обʼєм як у кнопок Minecraft: світла смуга зверху, темна знизу; при натисканні «просідає».
    Rectangle {
        x: 2px;
        y: 2px;
        width: parent.width - 4px;
        height: 2px;
        background: ta.pressed ? transparent : #ffffff22;
    }
    Rectangle {
        x: 2px;
        y: parent.height - 5px;
        width: parent.width - 4px;
        height: 3px;
        background: ta.pressed ? transparent : #00000055;
    }
    label := Text {
        y: ta.pressed ? 1px : -1px;
        height: parent.height;
        text: root.text;
        color: root.primary ? Theme.on-accent : (root.danger && ta.has-hover ? Theme.red : Theme.text);
        font-family: Theme.body;
        font-weight: 700;
        font-size: root.font-size;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// Поле вводу з рамкою, підсвіткою фокуса й підказкою.
export component Field inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> mono: false;
    in property <bool> enabled: true;
    callback accepted(string);
    callback edited(string);
    height: 42px;
    border-radius: 0px;
    background: Theme.bg.with-alpha(0.75);
    border-width: 2px;
    border-color: input.has-focus ? Theme.cyan : Theme.line-strong;
    opacity: root.enabled ? 1 : 0.5;
    forward-focus: input;
    Text {
        x: 13px;
        text: root.placeholder;
        visible: input.text == "";
        color: Theme.muted.with-alpha(0.6);
        font-family: root.mono ? Theme.mono : Theme.body;
        font-size: 14px;
        vertical-alignment: center;
        height: parent.height;
    }
    input := TextInput {
        x: 13px;
        width: parent.width - 26px;
        height: parent.height;
        text <=> root.text;
        enabled: root.enabled;
        color: Theme.text;
        font-family: root.mono ? Theme.mono : Theme.body;
        font-size: 14px;
        vertical-alignment: center;
        single-line: true;
        selection-background-color: Theme.cyan.with-alpha(0.33);
        accepted => { root.accepted(self.text); }
        edited => { root.edited(self.text); }
    }
}

export component Toggle inherits Rectangle {
    in-out property <bool> checked;
    callback toggled(bool);
    width: 42px;
    height: 24px;
    border-radius: 0px;
    background: root.checked ? Theme.accent : #ffffff1f;
    knob := Rectangle {
        y: 3px;
        x: root.checked ? 21px : 3px;
        width: 18px;
        height: 18px;
        border-radius: 0px;
        background: white;
        animate x { duration: 150ms; easing: ease-out; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

// Повзунок без зайвого: доріжка з градієнтом і кругла ручка.
export component Slider inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> step: 1;
    in-out property <float> value;
    callback changed(float);
    height: 28px;
    property <float> frac: (root.value - root.minimum) / max(0.0001, root.maximum - root.minimum);
    Rectangle {
        y: (parent.height - 6px) / 2;
        height: 6px;
        border-radius: 0px;
        background: #ffffff1a;
    }
    Rectangle {
        x: 0;
        y: (parent.height - 6px) / 2;
        width: (root.width - 20px) * root.frac + 10px;
        height: 6px;
        border-radius: 0px;
        background: Theme.accent;
    }
    Rectangle {
        x: (root.width - 20px) * root.frac;
        y: (parent.height - 20px) / 2;
        width: 20px;
        height: 20px;
        border-radius: 0px;
        background: white;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        function set(px: length) {
            let f = clamp((px - 10px) / (root.width - 20px), 0, 1);
            let raw = root.minimum + f * (root.maximum - root.minimum);
            root.value = clamp(round(raw / root.step) * root.step, root.minimum, root.maximum);
            root.changed(root.value);
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { self.set(self.mouse-x); }
        }
        moved => { if (self.pressed) { self.set(self.mouse-x); } }
    }
}

// Сегментований перемикач на кілька варіантів.
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in-out property <int> current;
    callback changed(int);
    height: 40px;
    border-radius: 0px;
    background: Theme.bg.with-alpha(0.75);
    border-width: 2px;
    border-color: Theme.line-strong;
    HorizontalLayout {
        padding: 4px;
        spacing: 4px;
        for opt[i] in root.options: Rectangle {
            border-radius: 0px;
            background: i == root.current ? Theme.line-strong : (sta.has-hover ? #ffffff0a : transparent);
            Text {
                text: opt;
                color: i == root.current ? Theme.text : Theme.muted;
                font-family: Theme.body;
                font-weight: 700;
                font-size: 13px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            sta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.current = i;
                    root.changed(i);
                }
            }
        }
    }
}

// Квадратна аватарка: обличчя скіна або перша літера ніка.
export component Avatar inherits Rectangle {
    in property <image> face;
    in property <bool> has-face;
    in property <string> initial;
    in property <length> size: 40px;
    width: root.size;
    height: root.size;
    border-radius: 0px;
    clip: true;
    background: Theme.line;
    if root.has-face: Image {
        width: parent.width;
        height: parent.height;
        source: root.face;
        image-rendering: pixelated;
    }
    if !root.has-face: Text {
        text: root.initial == "" ? "?" : root.initial;
        font-family: Theme.display;
        font-weight: 800;
        font-size: root.size * 0.42;
        color: Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
        overflow: clip;
    }
}
